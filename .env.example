# Database (Supabase PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/harada_quest?prepareThreshold=0
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Security
JWT_SECRET=change-this-to-a-secure-256-bit-base64-secret-key-in-production
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Hardcore Rule
HARADA_HARDCORE_MAX_MISSED_DAYS=2

